+# ISO 639-1 -> kokoro lang code. ja/zh need misaki[ja]/misaki[zh], so they are left out.
+LANG_CODE_MAP = {
+    'en': 'a',  # american english
+    'es': 'e',  # spanish
+    'fr': 'f',  # french
+    'hi': 'h',  # hindi
+    'it': 'i',  # italian
+    'pt': 'p',  # brazilian portuguese
+}
+
+
+def detect_lang_code(sentence, default_lang):
+    """Detect the language of a sentence and return a kokoro lang code.
+
+    Falls back to default_lang (the voice's native language) when langdetect
+    is not installed or the sentence is too short/ambiguous to detect.
+    """
+    try:
+        from langdetect import detect_langs
+        best = detect_langs(sentence)[0]
+    except Exception:
+        return default_lang
+    if best.prob >= 0.5 and best.lang in LANG_CODE_MAP:
+        return LANG_CODE_MAP[best.lang]
+    return default_lang
+
+
+def make_lang_pipelines(native_lang):
+    """Build a get_pipeline(lang) callable that lazily creates one KPipeline
+    per language, all sharing a single KModel.
+
+    Kokoro voices are style embeddings on a shared model, so passing the same
+    voice to every pipeline keeps its timbre while each language G2P produces
+    the right phonemes (e.g. an English quote inside a Portuguese book).
+    """
+    pipelines = {native_lang: KPipeline(lang_code=native_lang)}
+    model = pipelines[native_lang].model
+
+    def get_pipeline(lang):
+        if lang not in pipelines:
+            pipelines[lang] = KPipeline(lang_code=lang, model=model)
+        return pipelines[lang]
+
+    return get_pipeline
+
+
